# Token do GitHub (Classic ou Fine-grained, ou utilize o token do GitHub CLI com 'gh auth login')
GITHUB_TOKEN=gho_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------------
# CONFIGURAÇÃO DE IA (Escolha seu provedor preferido)
# -------------------------------------------------------------

# 1. Ollama (ex: seu servidor na Ambialles)
OLLAMA_URL=https://ollama.ambialles.com
OLLAMA_MODEL=llama3.2
# Se o seu Ollama / Nginx exigir autenticação básica (usuário e senha):
OLLAMA_USER=
OLLAMA_PASSWORD=
# Ou se exigir Bearer Token / API Key:
OLLAMA_API_KEY=

# 2. Google Gemini (Opcional - se preferir utilizar a API do Google)
# Obtenha sua chave gratuita em https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. OpenCode / OpenAI (Opcional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Porta do Servidor (Padrão: 3000)
PORT=3000
